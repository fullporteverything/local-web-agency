# Copy to .env.local for local dev. In production, set these in Vercel (Project → Settings → Environment Variables).
# Never commit real values.

# --- Brand (public) ---
NEXT_PUBLIC_AGENCY_NAME="Northcross"
NEXT_PUBLIC_AGENCY_SHORT_NAME="Northcross"
NEXT_PUBLIC_AGENCY_DOMAIN="northcrossweb.com"
NEXT_PUBLIC_SITE_URL="https://northcrossweb.com"
NEXT_PUBLIC_AGENCY_EMAIL="hello@northcrossweb.com"
NEXT_PUBLIC_OWNER_NAME="Acen"
NEXT_PUBLIC_OWNER_FULL_NAME=""
NEXT_PUBLIC_AGENCY_PHONE=""
# PO box or virtual mailbox. Required (CAN-SPAM) before any outreach is sent.
NEXT_PUBLIC_MAILING_ADDRESS=""
# Cal.com or Calendly link
NEXT_PUBLIC_BOOKING_URL=""

# --- Convex (database) ---
# Local dev: `npx convex dev` writes CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL here for you.
# Vercel: only CONVEX_DEPLOY_KEY is needed (Convex dashboard → Settings → Deploy key); the build sets the URL.
CONVEX_DEPLOYMENT=""
NEXT_PUBLIC_CONVEX_URL=""
CONVEX_DEPLOY_KEY=""
# Shared secret so website forms can save leads. Printed by scripts/setup-convex-env.mjs.
INBOUND_SECRET=""

# --- Set on Convex, not here (npx convex env set NAME value, or the setup script) ---
# OWNER_EMAIL         the email you log into the CRM with
# SITE_URL            https://youragency.com
# JWT_PRIVATE_KEY, JWKS   login signing keys (the setup script makes these)
# RESEND_API_KEY      sends login emails (without it, links are only printed in the Convex logs)
# AUTH_EMAIL_FROM     e.g. "Northcross <login@northcrossweb.com>"

# --- Added in later build steps ---
# ANTHROPIC_API_KEY=""
# GOOGLE_PLACES_API_KEY=""
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# GOOGLE_OAUTH_CLIENT_ID=""
# GOOGLE_OAUTH_CLIENT_SECRET=""
# VERCEL_API_TOKEN=""
